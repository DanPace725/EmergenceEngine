{
  "name": "emergence-engine",
  "version": "1.0.0",
  "description": "A simulation engine for emergent behaviors",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "analyze:dashboard": "node analysis/dashboard-generator.js",
    "analyze:dashboard:enhanced": "node analysis/enhanced-dashboard-generator.js",
    "analyze:dashboard:serve": "npm run analyze:dashboard && vite --config analysis/vite.config.js --port 3001",
    "dashboard": "npm run analyze:dashboard:enhanced"
  },
  "dependencies": {
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "vite": "^4.5.0"
  }
}
